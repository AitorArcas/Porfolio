---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/url';

interface Props {
  project: CollectionEntry<'proyectos'>;
}

const { project } = Astro.props;
const formattedDate = project.data.date.toLocaleDateString('es-ES', {
  month: 'short',
  year: 'numeric',
});
---

<a
  href={withBase(`/proyectos/${project.id}`)}
  class="reveal group -mx-2 flex flex-col gap-3 rounded px-2 py-8 transition-colors hover:bg-surface sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
>
  <div class="min-w-0">
    <h3 class="text-xl transition-colors group-hover:text-accent">
      {project.data.title}
    </h3>
    <p class="mt-2 max-w-prose text-muted">{project.data.description}</p>
    <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted">
      {project.data.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  </div>
  <span class="shrink-0 text-sm text-muted">{formattedDate}</span>
</a>
