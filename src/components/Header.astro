---
import { SITE, NAV_LINKS } from '../consts';

// Compara con la ruta actual para resaltar el enlace activo en la nav.
// "/" necesita comparación exacta; el resto, con o sin barra final.
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-border bg-bg">
  <div class="mx-auto flex max-w-content items-center justify-between px-6 py-4">
    <a href="/" class="font-display text-lg font-semibold">
      {SITE.name}
    </a>

    <nav aria-label="Navegación principal">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'transition-colors hover:text-accent',
                isActive(link.href) ? 'text-accent' : 'text-muted',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
