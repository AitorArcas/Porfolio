---
import Layout from '../layouts/Layout.astro';
import ProjectListItem from '../components/ProjectListItem.astro';
import { getCollection } from 'astro:content';

const focusAreas = ['Frontend', 'Backend', 'Programación asistida por IA'];

const allProjects = (await getCollection('proyectos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featuredProjects = allProjects.slice(0, 3);
const hasMoreProjects = allProjects.length > featuredProjects.length;
---

<Layout title="Inicio">
  <section class="mx-auto flex min-h-full max-w-content flex-col px-6 py-10">
    <div class="flex flex-1 flex-col justify-center">
      <p class="text-sm text-muted">Aitor Arcas — Desarrollo de software</p>
      <h1 class="mt-4 text-3xl sm:text-4xl">
        Construyo software combinando fundamentos sólidos con herramientas de IA modernas.
      </h1>
      <p class="mt-6 max-w-prose text-lg text-muted">
        Estoy formándome como desarrollador full stack. Uso Claude Code y otras
        herramientas de IA como parte real de mi forma de trabajar, no como un
        añadido de moda: me ayudan a pensar mejor cómo construir las cosas, no
        solo a escribirlas más rápido. Este mismo portfolio es un buen ejemplo:
        lo he diseñado y construido paso a paso, en conversación con IA.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/proyectos"
          class="rounded bg-accent px-5 py-2.5 text-sm font-medium text-black transition-colors hover:bg-accent-strong"
        >
          Ver proyectos
        </a>
        <a
          href="/contacto"
          class="rounded border border-border px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
        >
          Hablemos
        </a>
      </div>
    </div>

    <div class="mt-10 border-t border-border pt-6">
      <ul class="flex flex-wrap gap-x-3 gap-y-2 text-sm text-muted">
        {focusAreas.map((area, i) => (
          <li class="flex items-center gap-3">
            {area}
            {i < focusAreas.length - 1 && <span class="text-border">·</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-content px-6 py-20 sm:py-28">
    <div class="mb-10 flex items-end justify-between gap-4">
      <h2 class="text-2xl">Proyectos</h2>
      {hasMoreProjects && (
        <a
          href="/proyectos"
          class="text-sm text-muted transition-colors hover:text-accent"
        >
          Ver todos los proyectos
        </a>
      )}
    </div>

    <div class="flex flex-col divide-y divide-border border-y border-border">
      {featuredProjects.map((project) => (
        <ProjectListItem project={project} />
      ))}
    </div>
  </section>
</Layout>
