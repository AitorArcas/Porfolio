---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../consts';
---

<Layout title="Contacto">
  <main class="mx-auto flex min-h-full max-w-content flex-col justify-center px-6 py-20">
    <p class="text-sm text-muted">Contacto</p>
    <h1 class="mt-4 max-w-2xl text-3xl sm:text-4xl">¿Hablamos?</h1>
    <p class="mt-6 max-w-prose text-lg text-muted">
      Si quieres comentarme una oferta, hacerme alguna pregunta sobre un
      proyecto, o simplemente charlar sobre desarrollo e IA, aquí tienes las
      vías más directas.
    </p>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
      <a
        href={`mailto:${SITE.email}`}
        class="rounded bg-accent px-5 py-3 text-center text-sm font-medium text-black transition-colors hover:bg-accent-strong"
      >
        Escríbeme a {SITE.email}
      </a>
      <a
        href={SITE.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded border border-border px-5 py-3 text-center text-sm font-medium transition-colors hover:border-accent hover:text-accent"
      >
        LinkedIn
      </a>
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded border border-border px-5 py-3 text-center text-sm font-medium transition-colors hover:border-accent hover:text-accent"
      >
        GitHub
      </a>
    </div>
  </main>
</Layout>
